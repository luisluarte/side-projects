# van der pol oscilator ---------------------------------------------------
generate_vdp <- function(steps, dt = 0.05, mu_seq) {
if (length(mu_seq) == 1) mu_seq <- rep(mu_seq, steps)
x1 <- numeric(steps)
x2 <- numeric(steps)
# init conditions
x1[1] <- 0.1
x2[1] <- 0.1
for (i in 1:(steps - 1)) {
# euler integration
x1[i + 1] <- x1[i] + x2[i] * dt
x2[i + 1] <- x2[i] + (-x1[i] + mu_seq[i] * (1 - x1[i]^2) * x2[i]) * dt
}
return(cbind(x1, x2))
}
# morphological computation -----------------------------------------------
make_morphological_model <- function(n_nodes = 100,
spectral_radius = 0.9,
leak = 0.3) {
# fixed randomly connected network
W <- matrix(runif(n_nodes * n_nodes, -1, 1), n_nodes, n_nodes)
# echo state property
W <- W * (spectral_radius / max(abs(eigen(W)$values)))
# feedback fixed random matrix
W_fb <- matrix(runif(n_nodes * 2, -1, 1), n_nodes, 2)
# external input fixed random matrix
W_in <- matrix(runif(n_nodes * 1, -1, 1), n_nodes, 1)
# store trained readouts
readouts <- list()
# train
# open loop + teacher
train <- function(target_data,
input_data = NULL,
readout_name = "default",
noise_level = 1e-3) {
# storage for representation
steps <- nrow(target_data)
states <- matrix(0, nrow = steps, ncol = n_nodes)
state <- rep(0, n_nodes)
if (is.null(input_data)) input_data <- rep(0, steps)
# morphology states over time
for (t in 1:(steps - 1)) {
# teacher forcing = feed exact target + noise
fb_signal <- target_data[t, ] + rnorm(2, mean = 0, sd = noise_level)
in_signal <- input_data[t]
# non-linear response (linear combination + non-linearity)
state_update <- tanh(W %*% state + W_fb %*% fb_signal + W_in * in_signal)
# enforce fading memory
state <- (1 - leak) * state + leak * as.vector(state_update)
states[t + 1, ] <- state
}
# we drop the first 10% as dynamics are non likely set
washout <- floor(steps * 0.1)
valid_states <- states[(washout + 1):steps, ]
valid_targets <- target_data[(washout + 1):steps, ]
# do readout (analytical solution)
# this model is basically: target ~ morphological_states
lambda <- 1e-4
W_out <- solve(t(valid_states) %*% valid_states + lambda * diag(n_nodes)) %*% t(valid_states) %*% valid_targets
readouts[[readout_name]] <<- W_out
}
# close loop
run <- function(steps, initial_y, input_data = NULL, readout_name = "default") {
# we get a specific readout
W_out <- readouts[[readout_name]]
out_data <- matrix(0, nrow = steps, ncol = 2)
# seed the reservoir
out_data[1, ] <- initial_y
state <- rep(0, n_nodes)
if (is.null(input_data)) input_data <- rep(0, steps)
# self generated dynamics
for (t in 1:(steps - 1)) {
fb_signal <- out_data[t, ]
in_signal <- input_data[t]
# dynamics update
state_update <- tanh(W %*% state + W_fb %*% fb_signal + W_in * in_signal)
state <- (1 - leak) * state + leak * as.vector(state_update)
# redo the prediction of the linear readout
out_data[t + 1, ] <- as.vector(t(W_out) %*% state)
}
return(out_data)
}
return(list(train = train, run = run))
}
