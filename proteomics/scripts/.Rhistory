# Set working directory
setwd("GitHub/side-projects/proteomics/scripts")
raw_dat <- readr::read_tsv("../data/combined_protein.tsv")
intensity_cols <- colnames(raw_dat) |> stringr::str_subset(pattern = "(Control|Tratamiento)_[0-9]+ Intensity")
ctrl_target_cols <- intensity_cols[stringr::str_detect(intensity_cols, "Control")]
trat_target_cols <- intensity_cols[stringr::str_detect(intensity_cols, "Tratamiento")]
print(length(ctrl_target_cols))
print(length(trat_target_cols))
library(dplyr)
library(stringr)
dat <- raw_dat %>%
mutate(across(
all_of(intensity_cols), ~ na_if(., 0)
))
t1 <- system.time({
v1 <- dat %>%
rowwise() %>%
mutate(
valid_ctrl = sum(!is.na(c_across(all_of(ctrl_target_cols)))),
valid_trat = sum(!is.na(c_across(all_of(trat_target_cols)))),
valid_total = valid_ctrl + valid_trat
) %>%
ungroup() %>%
filter(
valid_total >= 8 & (valid_ctrl >= 4 | valid_trat >= 4)
)
})
t2 <- system.time({
v2 <- dat %>%
mutate(
valid_ctrl = rowSums(!is.na(select(., all_of(ctrl_target_cols)))),
valid_trat = rowSums(!is.na(select(., all_of(trat_target_cols)))),
valid_total = valid_ctrl + valid_trat
) %>%
filter(
valid_total >= 8 & (valid_ctrl >= 4 | valid_trat >= 4)
)
})
print(t1)
print(t2)
print(all.equal(v1, v2))
print(nrow(dat))
print(nrow(v2))
library(QFeatures)
metadata <- data.frame(
row.names = intensity_cols,
sample_id = intensity_cols,
condition = factor(
if_else(str_detect(intensity_cols, "Control"), "Control", "Treatment"),
levels = c("Control", "Treatment")
)
)
valid_df <- as.data.frame(v2)
fts <- readQFeatures(
assayData = valid_df,
quantCols = intensity_cols,
name = "raw_maxlfq"
)
colData(fts) <- DataFrame(metadata)
fts <- logTransform(fts, i = "raw_maxlfq", name = "log2maxlfq")
fts <- normalize(fts,
i = "log2maxlfq",
name = "normalized_maxlfq",
method = "center.median"
)
fts <- impute(
fts,
i = "normalized_maxlfq",
name = "imputed_maxlfq",
method = "MinProb"
)
print(fts)
colnames(row_metadata)
library(QFeatures)
row_metadata <- rowData(fts[["imputed_maxlfq"]])
print(colnames(row_metadata))
