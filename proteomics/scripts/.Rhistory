vdp_pattern_2 <- generate_vdp(steps = 2000, dt = 0.01, mu_seq = 2.5) # Gait 2
model1 <- make_morphological_model()
# train two different readouts on the same 'body'
model1$train(target_data = vdp_pattern_1, readout_name = "gait_1")
model1$train(target_data = vdp_pattern_2, readout_name = "gait_2")
# closed-loop
simulated_gait_1 <- model1$run(steps = 2000, initial_y = vdp_pattern_1[1, ], readout_name = "gait_1")
simulated_gait_2 <- model1$run(steps = 2000, initial_y = vdp_pattern_2[1, ], readout_name = "gait_2")
# plots
