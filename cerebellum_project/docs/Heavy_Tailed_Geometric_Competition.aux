\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Augmented 4-Panel Master Diagnostic Suite. (A) Posterior predictive density check demonstrating that the Bayesian Regularized Gamma LMM matches the empirical right-skewed heavy tail of true pause events. (B) Gamma multiplicative ejection showing the proportional $+2.29\%$ energy scaling. (C) Extreme Value Theory tail excess distributions showing the $+44.0\%$ broadening of scale dispersion ($\sigma = 0.374 \to 0.538$). (D) Information criteria ranking across continuous non-Gaussian topologies.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:augmented_master}{{1}{4}{Augmented 4-Panel Master Diagnostic Suite. (A) Posterior predictive density check demonstrating that the Bayesian Regularized Gamma LMM matches the empirical right-skewed heavy tail of true pause events. (B) Gamma multiplicative ejection showing the proportional $+2.29\%$ energy scaling. (C) Extreme Value Theory tail excess distributions showing the $+44.0\%$ broadening of scale dispersion ($\sigma = 0.374 \to 0.538$). (D) Information criteria ranking across continuous non-Gaussian topologies}{figure.caption.3}{}}
